generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique @db.VarChar(255)
  password    String       @db.VarChar(255)
  username    String       @unique @db.VarChar(100)
  isPublic    Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamp(6)
  projects    Project[]
  collections Collection[]
}

model Project {
  id            Int          @id @default(autoincrement())
  userId        Int
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String       @db.VarChar(255)
  mediums       String[]
  substrates    String[]     @default([])
  genres        String[]
  dimensions Float[]
  mode          String       @db.VarChar(20)
  isPublic      Boolean      @default(false)
  isFinalized   Boolean      @default(false)
  isRealism     Boolean      @default(false)
  isMonochrome  Boolean      @default(false)
  collaborators String[]
  createdAt     DateTime     @default(now()) @db.Timestamp(6)
  artSessions   ArtSession[]
  collections   Collection[]
  reference     Reference?
}

model Reference {
  id        Int     @id @default(autoincrement())
  projectId Int     @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl  String  @db.VarChar(500)
  colors    Color[]
  statistics Json?
}

model ArtSession {
  id         Int      @id @default(autoincrement())
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl   String   @db.VarChar(500)
  isFinal    Boolean  @default(false)
  hoursSpent Float?
  comments   String?
  loggedAt   DateTime @default(now()) @db.Timestamp(6)
  colors     Color[]
  statistics Json?
  comparedToReference Json?
}

model Color {
  id           Int         @id @default(autoincrement())
  artSessionId Int?
  artSession   ArtSession? @relation(fields: [artSessionId], references: [id], onDelete: Cascade)
  referenceId  Int?
  reference    Reference?  @relation(fields: [referenceId], references: [id], onDelete: Cascade)
  hex          String      @db.VarChar(7)
  weight       Float
  hue          Float
  saturation   Float
  value        Float
  tonalRange   String      @db.VarChar(10) // "overall" | "shadow" | "midtone" | "highlight"
}

model Collection {
  id       Int       @id @default(autoincrement())
  userId   Int
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String    @db.VarChar(255)
  isPublic Boolean   @default(false)
  projects Project[]
}